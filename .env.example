# Supabase 연결 정보 (Supabase 대시보드 > Project Settings > API 에서 확인)
# 이 파일을 복사해 .env 로 저장하고 실제 값을 채우세요:  cp .env.example .env
#
# 주의: VITE_ 접두사가 붙은 값은 브라우저 번들에 그대로 노출됩니다.
#       anon key는 공개되어도 되는 키이며(공개 전제), 데이터 보안은 DB의 RLS가 담당합니다.
#       service_role key는 절대 여기(또는 프론트엔드/저장소)에 넣지 마세요.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# 선택: 설정 탭에서 전체 피드백을 볼 수 있는 관리자 계정의 Supabase auth UID.
# (Authentication > Users 에서 본인 계정 UID 확인). 실제 접근 제어는 DB RLS의
# app.admin_uid 설정이 담당 — 이 값은 UI 노출 여부만 결정한다. 비워두면 피드백
# 목록 섹션이 보이지 않는다.
VITE_ADMIN_UID=
